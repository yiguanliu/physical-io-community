{
  "name": "@physical-io/workspace-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "design.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "tsc -p tsconfig.lib.json && node scripts/finish-build.mjs",
    "build:gallery": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/theme.test.ts"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "radix-ui": "1.6.7",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "4.23.12"
  }
}
